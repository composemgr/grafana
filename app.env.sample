# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=grafana.example.com

SERVICE_USER=1000
SERVICE_GROUP=1000

APP_ORG_NAME=Grafana
APP_RUN_AS=1000:1000

APP_ADMIN_USER=admin
APP_ADMIN_PASS=replace-with-a-random-password

APP_SECRET_KEY=replace-with-a-random-password

GF_INSTALL_PLUGINS=

EMAIL_SERVER_PORT=587
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_MAIL_FROM=grafana@example.com
EMAIL_SERVER_LOGIN_NAME=replace-with-your-smtp-username
EMAIL_SERVER_LOGIN_PASS=replace-with-your-smtp-password

CLOUDFLARE_ZONE_NAME=example.com
CLOUDFLARE_TUNNEL_ID=replace-with-your-tunnel-id
